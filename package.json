{
  "name": "recallmd",
  "version": "0.1.0",
  "private": true,
  "description": "Turn Markdown notes into spaced-repetition flashcards, in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4130 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4131 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright": "1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
